FROM odoo:19.0@sha256:e415f9924395e7521245813135112f264b9222bcde3b1d3c2ee9ff073081540a

USER root

COPY requirements-audit.txt /tmp/requirements-audit.txt

RUN pip3 install --no-cache-dir --break-system-packages --ignore-installed \
      -r /tmp/requirements-audit.txt \
    && rm -f /tmp/requirements-audit.txt

COPY --chown=odoo:odoo ai_processing /mnt/extra-addons/ai_processing

USER odoo
