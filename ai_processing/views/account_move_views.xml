<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ai_processing" model="ir.ui.view">
        <field name="name">account.move.form.ai.processing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="aip_can_analyze" invisible="1"/>
                <field name="aip_can_apply" invisible="1"/>
                <button name="action_aip_queue"
                        type="object"
                        string="Analizar documento"
                        class="btn-secondary"
                        invisible="not aip_can_analyze"/>
                <button name="action_aip_apply"
                        type="object"
                        string="Aplicar al borrador"
                        class="btn-primary"
                        invisible="not aip_can_apply"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="AI Processing"
                      name="ai_processing"
                      invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')">
                    <group>
                        <group>
                            <field name="aip_state" widget="badge" readonly="1"/>
                            <field name="aip_protocol" readonly="1"/>
                            <field name="aip_model_identifier" readonly="1"/>
                            <field name="aip_model_role" readonly="1"/>
                            <field name="aip_last_analysis_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="aip_document_id" readonly="1"/>
                            <field name="aip_attachment_checksum" readonly="1"/>
                            <field name="aip_duplicate_move_id" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not aip_message">
                        <field name="aip_message" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info" role="alert">
                        La IA aporta evidencia. Revise proveedor, conceptos, cuentas,
                        impuestos y totales antes de publicar.
                    </div>
                    <field name="aip_result" widget="json" readonly="1" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
